@model FishShopASP.Data.OrderItem

@{
    ViewData["Title"] = "Премахване";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="auth2-card shadow-soft border-0">
                <div class="p-4 border-bottom bg-light text-center rounded-top-4">
                    <div class="display-4 text-danger mb-2">🗑️</div>
                    <h3 class="fw-bold mb-0">Премахване на артикул</h3>
                    <p class="text-muted mb-0">Сигурни ли сте, че искате да премахнете този продукт?</p>
                </div>

                <div class="auth2-body p-4">
                    <div class="p-3 border rounded-3 bg-white mb-4">
                        <h5 class="fw-bold mb-1">@Model.Products?.Name</h5>
                        <div class="small text-muted">
                            Количество: <strong>@Model.Quantity бр.</strong>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger py-3 rounded-pill shadow-sm fw-bold">
                                Потвърждавам изтриването
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary py-3 rounded-pill">
                                Отказ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>