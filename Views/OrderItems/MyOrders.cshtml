@model IEnumerable<FishShopASP.Data.OrderItem>

@{
    ViewData["Title"] = "История на поръчките";
    var groupedOrders = Model.GroupBy(x => x.OrderNumber ?? x.RegOn.ToString("yyyyMMddHHmmss")).OrderByDescending(g => g.Max(x => x.RegOn));
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold brand-name mb-1">История на покупките</h1>
            <p class="text-muted mb-0">Преглед на вашите завършени поръчки</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
            Към количката
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="auth2-card p-5 text-center shadow-soft">
            <h3 class="fw-semibold text-muted mb-0">Нямате регистрирани поръчки.</h3>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var orderGroup in groupedOrders)
            {
                var firstItem = orderGroup.First();
                var orderTotal = orderGroup.Sum(item => (decimal)item.Products.Price * item.Quantity);

                <div class="col-12 mb-4">
                    <div class="auth2-card shadow-soft border-0">
                        <div class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center rounded-top-4">
                            <div>
                                <span class="fw-bold text-dark me-3">ПОРЪЧКА @orderGroup.Key</span>
                                <span class="text-muted small">
                                    <i class="bi bi-calendar3"></i> @firstItem.RegOn.ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>
                            <span class="badge bg-success rounded-pill px-3 py-2">ЗАВЪРШЕНА</span>
                        </div>

                        <div class="auth2-body p-4">
                            <div class="table-responsive">
                                <table class="table table-borderless align-middle mb-0">
                                    <thead class="text-muted small text-uppercase">
                                        <tr>
                                            <th>Продукт</th>
                                            <th class="text-center">Количество</th>
                                            <th class="text-end">Ед. Цена</th>
                                            <th class="text-end">Общо</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in orderGroup)
                                        {
                                            <tr>
                                                <td class="fw-bold text-navy py-3">@item.Products.Name</td>
                                                <td class="text-center">@item.Quantity бр.</td>
                                                <td class="text-end text-muted">@item.Products.Price.ToString("0.00") €</td>
                                                <td class="text-end fw-semibold">@(((decimal)item.Products.Price * item.Quantity).ToString("0.00")) €</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center">
                                <span class="text-muted fw-bold small text-uppercase">Обща сума за поръчката</span>
                                <span class="h3 fw-bold text-success mb-0">@orderTotal.ToString("0.00") €</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
