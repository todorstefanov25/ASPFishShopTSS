@{
    ViewData["Title"] = "Риболовен майстор";
}

<div class="hero-section text-white d-flex align-items-center">
    <div class="container-fluid text-center px-0">
        <h1 class="display-3 fw-bold mb-3">Риболовен майстор</h1>

        <p class="lead mb-4">
            Всичко необходимо за успешен риболов – въдици, макари, примамки и аксесоари
        </p>

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-warning btn-lg px-4 fw-bold">
                Разгледай продуктите
            </a>
        </div>
    </div>
</div>

<footer class="site-footer">
    <div class="container-fluid">
        <div class="row text-center text-md-start">

            <div class="col-md-4 mb-4">
                <h5 class="fw-bold">Риболовен майстор</h5>

                <p>
                    Онлайн магазин за качествени риболовни принадлежности,
                    аксесоари и оборудване.
                </p>
            </div>

            <div class="col-md-4 mb-4">
                <h5 class="fw-bold">Полезни връзки</h5>

                <ul class="list-unstyled">
                    <li>
                        <a asp-controller="Home" asp-action="Index">
                            Начало
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Products" asp-action="Index">
                            Продукти
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home" asp-action="Contacts">
                            Контакти
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home" asp-action="Terms">
                            Условия
                        </a>
                    </li>
                </ul>
            </div>

            <div class="col-md-4 mb-4">
                <h5 class="fw-bold">Контакти</h5>

                <p class="mb-1">📍 гр. Сопот, България</p>
                <p class="mb-1">📞 +359 888 352 906</p>
                <p class="mb-1">✉ info@ribolovenmaistor.bg</p>
            </div>
        </div>

        <hr class="footer-line" />

        <div class="text-center">
            <p class="mb-0">
                &copy; @DateTime.Now.Year - Риболовен майстор.
                Всички права запазени.
            </p>
        </div>
    </div>
</footer>