@{
    ViewData["Title"] = "Контакти";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="mb-4">
                <h1 class="display-6 fw-bold brand-name">Контакти</h1>
                <p class="text-muted">Свържете се с нас за въпроси относно вашите поръчки.</p>
            </div>

            <div class="auth2-card shadow-soft p-4 p-lg-5">
                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-white h-100">
                            <h5 class="fw-bold brand-name mb-3">Информация за връзка</h5>
                            <p class="mb-2">
                                <strong>📍 Адрес:</strong><br />
                                гр. София, бул. "Витоша" 100
                            </p>
                            <p class="mb-2">
                                <strong>📞 Телефон:</strong><br />
                                0888 123 456
                            </p>
                            <p class="mb-0">
                                <strong>📧 Имейл:</strong><br />
                                support@fishshop.bg
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-white h-100">
                            <h5 class="fw-bold brand-name mb-3">Работно време</h5>
                            <ul class="list-unstyled mb-0">
                                <li class="d-flex justify-content-between mb-2">
                                    <span>Понеделник - Петък:</span>
                                    <span class="fw-bold text-success">09:00 - 18:30</span>
                                </li>
                                <li class="d-flex justify-content-between mb-2">
                                    <span>Събота:</span>
                                    <span class="fw-bold text-success">10:00 - 16:00</span>
                                </li>
                                <li class="d-flex justify-content-between">
                                    <span>Неделя:</span>
                                    <span class="text-danger">Почивен ден</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-12 mt-4">
                        <div class="p-4 rounded-3 border bg-light text-center">
                            <p class="mb-0 text-muted">
                                Нашите консултанти ще отговорят на вашето запитване в рамките на 24 часа.
                            </p>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>