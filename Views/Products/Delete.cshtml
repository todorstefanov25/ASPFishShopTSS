@model FishShopASP.Data.Product

@{
    ViewData["Title"] = "Изтриване на продукт";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="mb-4">
                <h2 class="fw-bold brand-name">Изтриване на продукт</h2>
                <hr />
                <div class="alert alert-danger shadow-sm">
                    Сигурни ли сте, че искате да изтриете този продукт от системата?
                </div>
            </div>

            <div class="auth2-card p-4 shadow-soft">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        @if (!string.IsNullOrWhiteSpace(Model.imageURL))
                        {
                            <img src="@Model.imageURL" alt="@Model.Name" class="img-fluid rounded border shadow-sm bg-white">
                        }
                        else
                        {
                            <div class="p-4 bg-light text-center rounded border text-muted fw-bold">
                                Няма снимка
                            </div>
                        }
                    </div>

                    <div class="col-md-8">
                        <table class="table table-borderless">
                            <tr>
                                <th class="text-muted" style="width: 40%">Каталожен №:</th>
                                <td class="fw-bold">@Model.CatalogNumber</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Име:</th>
                                <td class="fw-bold">@Model.Name</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Категория:</th>
                                <td>@Model.Categories?.Name</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Цена:</th>
                                <td class="text-success fw-bold">@Model.Price.ToString("0.00") €</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Дата на добавяне:</th>
                                <td>@Model.RegOn.ToString("dd.MM.yyyy")</td>
                            </tr>
                        </table>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mt-3 p-3 bg-light rounded border">
                        <small class="d-block text-muted mb-1 fw-bold">Описание:</small>
                        <p class="mb-0">@Model.Description</p>
                    </div>
                }

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <form asp-action="Delete" class="flex-grow-1">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger w-100 rounded-pill fw-bold py-2 shadow-sm">
                            Да, изтрий го
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        Отказ
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
