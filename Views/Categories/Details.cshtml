@model FishShopASP.Data.Category

@{
    ViewData["Title"] = "Детайли на категория";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="auth2-card shadow-soft border-0">
                <div class="p-4 border-bottom bg-light text-center rounded-top-4">
                    <div class="display-4 text-primary mb-2">📂</div>
                    <h3 class="fw-bold mb-0">Детайли за категория</h3>
                    <p class="text-muted mb-0">Преглед на информацията за избраната група</p>
                </div>

                <div class="auth2-body p-4">
                    <div class="mb-4 text-center">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Име на категорията</label>
                        <h4 class="fw-bold text-dark">@Model.Name</h4>
                    </div>

                    <div class="border-top pt-4">
                        <div class="d-grid gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning py-2 rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-pencil-square me-2"></i>Редактиране
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary py-2 rounded-pill">
                                Обратно към списъка
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>