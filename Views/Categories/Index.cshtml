@model IEnumerable<FishShopASP.Data.Category>

@{
    ViewData["Title"] = "Категории";
}

<div class="page-head">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
        <div>
            <h1 class="h3 fw-bold mb-1">Категории</h1>
            <div class="text-muted">Създавай и управлявай категориите в магазина.</div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary btn-lg px-4">
                + Нова категория
            </a>
        </div>
    </div>
</div>

<div class="categories-grid mt-3">
    @foreach (var item in Model)
    {
        <div class="category-card">
            <div class="category-body">
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div class="min-w-0">
                        <div class="category-title text-truncate">@item.Name</div>
                        <div class="category-sub text-muted">ID: <span class="fw-semibold">@item.Id</span></div>
                    </div>

                    <span class="badge rounded-pill text-bg-light border category-badge">
                        Категория
                    </span>
                </div>

                <div class="category-actions mt-3">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">
                        Детайли
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                        Редакция
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">
                        Изтрий
                    </a>
                </div>
            </div>
        </div>
    }
</div>