@model IEnumerable<FishShopASP.Data.Category>

@{
    ViewData["Title"] = "Категории";
}

<div class="container-fluid px-4 py-4">

    <div class="page-head shadow-soft mb-4 p-4 auth2-card border-0">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="small text-uppercase fw-bold text-muted">
                    FishShopASP
                </span>
                <h1 class="display-6 fw-bold mb-1 brand-name">
                    Категории
                </h1>
                <p class="text-muted mb-0">
                    Създавай и управлявай категориите в магазина.
                </p>
            </div>

            <a asp-action="Create"
               class="btn btn-primary auth2-primary btn-lg px-4 rounded-pill fw-bold shadow">
                + Нова категория
            </a>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="auth2-card h-100 shadow-soft border-0">
                    <div class="p-4">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="brand-icon">
                                    <i class="bi bi-tag-fill"></i>
                                </div>
                                <div>
                                    <div class="fs-4 fw-bold text-navy">
                                        @item.Name
                                    </div>
                                    <div class="small text-muted">
                                        ID: <span class="fw-semibold">@item.Id</span>
                                    </div>
                                </div>
                            </div>
                            <span class="badge rounded-pill bg-light text-dark border px-3 py-2">
                                Категория
                            </span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary rounded-pill px-3 fw-semibold flex-grow-1">
                                Детайли
                            </a>
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-secondary rounded-pill px-3 fw-semibold flex-grow-1">
                                Редакция
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-danger rounded-pill px-3 fw-semibold">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>