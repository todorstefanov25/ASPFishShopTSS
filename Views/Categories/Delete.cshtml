@model FishShopASP.Data.Category

@{
    ViewData["Title"] = "Изтриване на категория";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="auth2-card shadow-soft border-0">
                <div class="p-4 border-bottom bg-light text-center rounded-top-4">
                    <div class="display-4 text-danger mb-2">⚠️</div>
                    <h3 class="fw-bold mb-0">Изтриване на категория</h3>
                    <p class="text-muted mb-0">Сигурни ли сте, че искате да премахнете тази група продукти?</p>
                </div>

                <div class="auth2-body p-4 text-center">
                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-1">Име на категорията</label>
                        <h4 class="fw-bold text-dark">@Model.Name</h4>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger py-2 rounded-pill fw-bold shadow-sm">
                                Да, изтрий категорията
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary py-2 rounded-pill">
                                Отказ и връщане
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>