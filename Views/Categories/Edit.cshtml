@model FishShopASP.Data.Category

@{
    ViewData["Title"] = "Редактиране на категория";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="auth2-card shadow-soft border-0">
                <div class="p-4 border-bottom bg-light text-center rounded-top-4">
                    <div class="display-4 text-warning mb-2">📝</div>
                    <h2 class="fw-bold brand-name mb-1">Редактиране</h2>
                    <p class="text-muted mb-0">Променете името на избраната категория</p>
                </div>

                <div class="auth2-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-dark">Име на категорията</label>
                            <input asp-for="Name" class="form-control rounded-pill px-4 shadow-sm" />
                            <span asp-validation-for="Name" class="text-danger small ms-3"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning py-2 rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-save me-2"></i>Запази промените
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary py-2 rounded-pill">
                                Отказ и връщане
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}